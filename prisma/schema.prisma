generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AppUser {
  id          String  @id @default(uuid())
  username    String  @unique
  password    String
  displayName String
  isAdmin     Boolean @default(false)
  createdAt   DateTime @default(now())
}

model WeddingSettings {
  id           String @id @default("default")
  weddingDate  String @default("")
  groomName    String @default("")
  brideName    String @default("")
  groomFamily  String @default("")
  brideFamily  String @default("")
  venue        String @default("")
  totalBudget  Float  @default(150000)
  language     String @default("he")
}

model Guest {
  id              String  @id @default(uuid())
  firstName       String
  lastName        String
  phone           String
  email           String?
  gender          String
  group           String
  side            String
  status          String  @default("טרם_הוזמן")
  numberOfGuests  Int     @default(1)
  numberOfChildren Int    @default(0)
  tableId         String?
  dietaryNotes    String?
  notes           String?
  rsvpLink        String?
  createdBy       String?

  rsvpResponse    RsvpResponse?

  table           Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
}

model RsvpResponse {
  id            String  @id @default(uuid())
  guestId       String  @unique
  attending     Boolean
  count         Int
  childrenCount Int     @default(0)
  dietaryNotes  String?
  respondedAt   DateTime @default(now())

  guest         Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model Table {
  id        String  @id @default(uuid())
  name      String
  section   String
  type      String
  capacity  Int     @default(10)
  x         Float   @default(0)
  y         Float   @default(0)
  createdBy String?

  guests    Guest[]
}

model BudgetItem {
  id          String  @id @default(uuid())
  category    String
  description String
  planned     Float   @default(0)
  actual      Float   @default(0)
  paid        Boolean @default(false)
  notes       String?
  createdBy   String?
}

model Vendor {
  id          String  @id @default(uuid())
  name        String
  category    String
  phone       String
  email       String?
  price       Float   @default(0)
  status      String  @default("בבדיקה")
  notes       String?
  contractUrl String?
  paymentDue  String?
  createdBy   String?
}

model ChecklistItem {
  id              String  @id @default(uuid())
  title           String
  description     String?
  category        String
  assignee        String
  dueWeeksBefore  Int
  completed       Boolean @default(false)
  completedAt     DateTime?
  createdBy       String?
}
